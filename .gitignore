# --- Secrets and session files: never commit these ---
*.session
*.session-journal
.env
.dev.vars

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
.pythonlibs/

# --- v3 runtime state: created and rewritten by the bot on the Repl ---
# User data, not source. One machine's todos/notes/reminders must never be
# merged into another checkout.
mode/afk.json
mode/notes.json
mode/todos.json
mode/reminders.json
mode/polls.json
mode/confirm.json
mode/settings.json
# !trivia session token and !guess rounds: runtime state, not source.
mode/trivia_token.json
mode/games.json
mode/ask.json
# !cauto's on/off switch: one Repl's runtime choice, not source.
mode/cauto.json

# --- bot UI state: flows, confirmations and the self-bot outbox ---
# Rewritten constantly and full of chat ids; never source.
mode/runtime.json
mode/botstate.json

# --- runtime output folders: transcripts, timers, scratch files ---
# Logs/ contains exported chat text and mods/ holds live timer state; both are
# recreated on start, so they must never be committed.
Logs/
mods/
temp/

# --- Large or personal data that is not source ---
# rockyou.txt is 140 MB of every checkout for a file `!wordlist download`
# fetches on demand; stats files are one machine's chat history. Tracked by
# accident in earlier commits -- untracked in v4, still on disk.
mode/rockyou.txt
mode/stats.json
mode/chatstats.json

# A stale concatenated dump of the source tree, kept for years and wrong.
project_files.txt

# --- !aiml models: rebuilt from data/markov_corpus.txt at runtime ---
# The old per-chat files were trained on Telegram messages and must not be used.
ML/models/
