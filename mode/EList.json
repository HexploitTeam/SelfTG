[
  {
    "id": 2,
    "text": "\u0634\u0627\u0644\u0627\u06a9\u0648\u0635 \u0645\u0627\u0631\u06a9\u0648\u0635\u0648\ud83d\ude10"
  },
  {
    "id": 3,
    "text": "\u06a9\u0648\u0628\u0635 \u0645\u0648\u0628\u0635 \u0646\u0646\u062a"
  },
  {
    "id": 4,
    "text": "\u0639\u0645\u0647 \u0646\u0646\u062a\u0648 \u06cc\u06a9\u06cc \u0645\u06cc\u06a9\u0646\u0645\u0627"
  },
  {
    "id": 5,
    "text": "\u0628\u06cc\u0627 \u0628\u0631\u0648 \u06a9\u0633 \u0645\u0627\u062f\u0631\u062a"
  },
  {
    "id": 6,
    "text": "\u0646\u0648\u0627\u0645\u06cc\u0633 \u062e\u06cc\u06a9\u06cc"
  },
  {
    "id": 7,
    "text": "\u0634\u0627\u0644\u0627\u06a9\u0648\u0635 \u067e\u062f\u0631"
  },
  {
    "id": 8,
    "text": "\u0646\u0648\u0627\u0645\u06cc\u0633 \u0627\u062d\u0645\u0642"
  },
  {
    "id": 9,
    "text": "\u067e\u062f\u0631 \u06a9\u0648\u0635\u06a9\u0634"
  },
  {
    "id": 10,
    "text": "\u0646\u0627\u0645\u0648\u0633 \u0632\u0646\u0627 \u0632\u0627\u062f\u0647"
  },
  {
    "id": 11,
    "text": "\u0634\u0627\u0634\u06cc\u062f\u0645 \u062f\u0631 \u0642\u0628\u0631 \u0646\u0648\u0627\u0645\u06cc\u0633\u062a"
  },
  {
    "id": 12,
    "text": "\u0645\u0627\u062f\u0631\u062a\u0648 \u0627\u0646\u062f\u0627\u062e\u062a\u0645 \u062a\u0648 \u0686\u0627\u0647 \u0645\u0633\u062a\u0631\u0627"
  },
  {
    "id": 13,
    "text": "\u062c\u0627\u06cc \u062a\u0633\u0645\u0647 \u062a\u0627\u06cc\u0645 \u0645\u0627\u0634\u06cc\u0646 \u0628\u0627\u0628\u0627\u062a \u0631\u0648 \u0628\u0627 \u0634\u0648\u0631\u062a \u0645\u0627\u062f\u0631\u062a \u0639\u0648\u0636 \u06a9\u0631\u062f\u0645 \u062a\u0627 \u0645\u0648\u0642\u0639 \u0627\u0633\u062a\u0627\u0631\u062a \u0632\u062f\u0646 \u0645\u0627\u0634\u06cc\u0646 \u0635\u062f\u0627 \u063a\u06cc\u0631\u062a \u0627\u0642\u0627\u062a \u0631\u0648 \u06cc\u06a9 \u0634\u0647\u0631 \u0628\u0634\u0646\u0648\u0646"
  },
  {
    "id": 14,
    "text": "\u0645\u0627\u062f\u0631\u062a \u0633\u0627\u0639\u062a \u0631\u0648 \u06f5 \u062f\u0642\u06cc\u0642\u0647 \u0628\u0647 \u062c\u0644\u0648 \u0645\u06cc\u06a9\u0634\u0647 \u062a\u0627 \u06f5 \u062f\u0642\u06cc\u0642\u0647 \u0628\u06cc\u0634\u062a\u0631 \u06a9\u0648\u0646 \u0628\u062f\u0647"
  },
  {
    "id": 15,
    "text": "\u0627\u0633\u062a\u0627\u0646\u062f\u0627\u0631\u06cc \u0645\u0631\u06a9\u0632\u06cc: \u062f\u0642\u0627\u06cc\u0642\u06cc \u067e\u06cc\u0634 \u06f5 \u0627\u0646\u0641\u062c\u0627\u0631 \u062f\u0631 \u0627\u062a\u0627\u0642 \u0645\u0627\u062f\u0631\u062a \u0634\u0646\u06cc\u062f\u0647 \u0634\u062f"
  },
  {
    "id": 16,
    "text": "\u0645\u0627\u062f\u0631\u062a \u062e\u062f\u0627\u0628\u06cc\u0627\u0645\u0631\u0632"
  },
  {
    "id": 17,
    "text": "\u0627\u0646\u062a\u0642\u0627\u0645 \u0645\u0627\u062f\u0631\u062a \u0631\u0627 \u0627\u0632 \u0627\u0645\u0631\u06cc\u06a9\u0627 \u0645\u06cc\u06af\u06cc\u0631\u0645"
  },
  {
    "id": 18,
    "text": "\u0628\u0627\u0628\u0627\u062a \u062a\u0648 \u0628\u06cc\u0648 \u0631\u0648\u0628\u06cc\u06a9\u0627\u0634 \u0646\u0648\u0634\u062a\u0647: \u0632\u0646\u062f\u0647 \u06cc\u0627 \u0645\u064f\u0631\u062f\u0647 \u062a\u0631\u0627\u0645\u067e \u06f1 \u0645\u06cc\u0644\u06cc\u0627\u0631\u062f \u0631\u06cc\u0627\u0644 \u0648\u062c\u0647 \u0631\u0627\u06cc\u062c \u0645\u0645\u0644\u06a9\u062a."
  },
  {
    "id": 19,
    "text": "\u0627\u06af\u0647 \u0645\u0633\u0627\u0628\u0642\u0647 \u0627\u0633\u06a9\u06cc \u0631\u0641\u062a\u0646 \u0647\u0645\u0631\u0627\u0647 \u0628\u06cc\u063a\u06cc\u0631\u062a\u06cc \u0648 \u0645\u0627\u062f\u0631\u06a9\u0633\u062f\u06af\u06cc \u0648 \u0646\u0648\u0644\u0627\u06cc\u0641\u06cc \u0628\u0631\u06af\u0632\u0627\u0631 \u0628\u0634\u0647 \u062c\u0648\u06a9\u0631 \u0646\u0641\u0631 \u0627\u0648\u0644 \u0645\u06cc\u0634\u0647 \u060c \u0627\u0644\u0628\u062a\u0647 \u0628\u0627 \u0627\u0633\u06a9\u06cc \u0631\u0641\u062a\u0646 \u0627\u0632 \u0645\u062f\u0627\u0644 \u0646\u0641\u0631 \u0627\u0648\u0644!\u00bb\ud83d\ude04"
  },
  {
    "id": 20,
    "text": "\u062a\u06cc\u0645 \u0628\u0627\u0628\u0627\u062a \u06af\u0644 \u062e\u0648\u0631\u062f \u0648 \u0628\u0627\u0628\u0627\u062a \u0628\u0631\u0627\u06cc \u0647\u0645\u06cc\u0634\u0647 \u0627\u0632 \u062c\u0627\u0645 \u062c\u0647\u0627\u0646\u06cc \u0641\u0648\u062a\u0628\u0627\u0644 \u0628\u06cc\u063a\u06cc\u0631\u062a\u06cc \u062e\u062f\u0627\u062d\u0627\u0641\u0638\u06cc \u06a9\u0631\u062f(\u0647\u0646\u0648\u0632 \u06f2 \u062f\u0642\u06cc\u0642\u0647 \u0645\u0648\u0646\u062f\u0647)"
  },
  {
    "id": 21,
    "text": "\u062e\u0648\u0627\u0647\u0631\u062a:\n \u062a\u06cc\u0645 \u0645\u0644\u06cc \u067e\u0631\u062a\u063a\u0627\u0644 \u062a\u0648\u0627\u0646\u0633\u062a \u0628\u0647 \u0645\u0631\u062d\u0644\u0647 \u0628\u0639\u062f\u06cc \u0635\u0639\u0648\u062f \u06a9\u0646\u062f \u0648 \u062d\u0631\u06cc\u0641 \u0627\u06cc\u0631\u0627\u0646 \u0634\u062f."
  },
  {
    "id": 22,
    "text": "\u0646\u0646\u062a \u0634\u0648\u0631\u062a\u0634\u0648 \u0628\u0631\u062f \u0631\u0648\u0646\u0627\u0644\u062f\u0648 \u0627\u0645\u0636\u0627 \u06a9\u0646\u0647"
  },
  {
    "id": 23,
    "text": "\u0645\u0627\u062f\u0631\u062a \u0633\u0631\u062f\u0627\u0631 \u0633\u0644\u06cc\u0645\u0627\u0646\u06cc"
  },
  {
    "id": 24,
    "text": "\u0645\u0627\u062f\u0631\u062a \u0648\u0627\u0633\u0647 \u0645\u062c\u062a\u0628\u06cc \u062e\u0627\u0645\u0646\u0647 \u0627\u06cc \u062c\u0639\u0644\u06cc \u063a\u0634 \u06a9\u0631\u062f \u0627\u0648\u0646 \u062f\u0646\u06cc\u0627 \u0645\u062c\u062a\u0628\u06cc \u0645\u0633\u062e\u0631\u0634 \u06a9\u0631\u062f"
  },
  {
    "id": 25,
    "text": "\u0645\u0627\u062f\u0631 \u062c\u0648\u0631\u062c\u06cc\u0646\u0627 \u0641\u0646\u062a \u0628\u0627 \u062e\u0628\u0631 \u0635\u0639\u0648\u062f \u0622\u0631\u0698\u0627\u0646\u062a\u06cc\u0646 \u0633\u06a9\u062a\u0647 \u06a9\u0631\u062f."
  },
  {
    "id": 26,
    "text": "\u0646\u0648\u0627\u0645\u06cc\u0633\u062a \u0645\u06cc\u0631\u0647 \u062f\u0627\u0633\u062a\u0627\u0646 \u0646\u0648\u062d \u0631\u0648 \u0645\u06cc\u062e\u0648\u0646\u0647 \u0645\u06cc\u0628\u06cc\u0646\u0647 \u0646\u0648\u062d \u0628\u0627 \u0639\u0635\u0627 \u062f\u0631\u06cc\u0627\u0631\u0648 \u0645\u06cc\u0634\u06a9\u0627\u0641\u0647 \u0645\u0627\u062f\u0631\u062a \u0645\u06cc\u06af\u0647 \u0645\u0646\u0645 \u0628\u0644\u062f\u0645\n\n\u0645\u06cc\u0631\u0647 \u062a\u0646\u06af\u0647 \u0647\u0631\u0645\u0632 \u0634\u0631\u062a\u0634\u0648 \u0645\u06cc\u062f\u0647 \u0628\u0627\u0644\u0627 \u0646\u0627\u06af\u0647\u0627\u0646 \u0646\u06cc\u0631\u0648 \u062f\u0631\u06cc\u0627\u06cc\u06cc \u0647\u0648\u0627\u0633\u0634 \u067e\u0631\u062a \u06a9\u0635 \u0646\u0646\u062a \u0645\u06cc\u0634\u0647 \u06a9\u0634\u062a\u06cc \u0647\u0627 \u0631\u062f \u0645\u06cc\u0634\u0646 \n\u0645\u0627\u062f\u0631\u062a \u06a9\u0627\u0631\u062a \u062a\u0646\u06af\u0647 \u0647\u0631\u0645\u0632\u0648 \u0628\u0627 \u0627\u06cc\u0646 \u06a9\u0627\u0631\u0634 \u0645\u06cc\u0633\u0648\u0632\u0648\u0646\u0647"
  },
  {
    "id": 27,
    "text": "\u0646\u0627\u0645\u0648\u0633\u062a \u0631\u0641\u062a \u067e\u06cc\u0634 \u062f\u06a9\u062a\u0631 \u0631\u0648\u0627\u0646\u0634\u0646\u0627\u0633\u060c \u06af\u0641\u062a \u0645\u0634\u06a9\u0644\u062a \u0686\u06cc\u0647\u061f \u06af\u0641\u062a \u0622\u0642\u0627\u06cc \u062f\u06a9\u062a\u0631 \u0645\u0646 \u0647\u0645\u06cc\u0634\u0647 \u067e\u06cc\u0634 \u0628\u0642\u06cc\u0647 \u06a9\u06cc\u0631 \u0645\u06cc\u0634\u0645.\n\n\u062f\u06a9\u062a\u0631 \u06af\u0641\u062a \u0628\u0627 \u062a\u0648 \u0646\u06cc\u0633\u062a\u0645 \u0645\u0627\u062f\u0631\u06a9\u0648\u0646\u06cc \u0628\u0627 \u067e\u0634\u062a \u0633\u0631\u06cc\u062a\u0645."
  },
  {
    "id": 28,
    "text": "\u0645\u0627\u062f\u0631\u062a \u06af\u0631\u0633\u0646\u0647 \u0645\u06cc\u0634\u0647 \u0647\u0648\u0633 \u0633\u06cc\u0631 \u0645\u06cc\u06a9\u0646\u0647 \u0628\u0627\u0628\u0627\u062a \u0634\u0644\u0648\u0627\u0631\u0634\u0648 \u0645\u06cc\u06a9\u0634\u0647 \u067e\u0627\u06cc\u06cc\u0646 \u0645\u0627\u062f\u0631\u062a \u0645\u06cc\u06af\u0647: \u06a9\u0633\u06a9\u0634 \u06af\u0641\u062a\u0645 \u0647\u0648\u0633 \u0633\u06cc\u0631 \u06a9\u0631\u062f\u0645 \u0646\u0647 \u0628\u0648\u0627\u0633\u06cc\u0631."
  },
  {
    "id": 29,
    "text": "\u0642\u0644\u06cc\u0648\u0646 \u0628\u0627\u0628\u0627\u062a\u0648 \u062a\u0648 \u0633\u0631 \u0645\u0627\u062f\u0631\u062a \u062e\u0648\u0631\u062f \u0645\u06cc\u06a9\u0646\u0645"
  },
  {
    "id": 30,
    "text": "\ud83d\udd34 \u0633\u0646\u062a\u06a9\u0627\u0645:\n\n\u0637\u06cc \u062f\u0648 \u0631\u0648\u0632 \u06af\u0630\u0634\u062a\u0647 \u0628\u06cc\u0634 \u0627\u0632 \u06f1\u06f7\u06f0 \u0647\u062f\u0641 \u0646\u0638\u0627\u0645\u06cc \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0631\u0627 \u0647\u062f\u0641 \u0642\u0631\u0627\u0631 \u062f\u0627\u062f\u06cc\u0645 \u06a9\u0647 \u06f1\u06f6\u06f9 \u062a\u0627\u0634 \u06a9\u0627\u0628\u0627\u0631\u0647 \u0647\u0627\u06cc \u0645\u0627\u062f\u0631\u062a \u0628\u0648\u062f\u0646 ."
  },
  {
    "id": 31,
    "text": "#\u0641\u0648\u0631\u06cc\n\u0645\u0627\u062f\u0631\u062a\u0648 \u0627\u0632 \u06a9\u0648\u0646"
  },
  {
    "id": 32,
    "text": "\u0628\u06cc\u06a9\u06cc\u0646\u06cc \u0628\u0627\u062a\u0645 \u0628\u0647 \u0645\u0648\u0627\u0636\u0639 \u0645\u0627\u062f\u0631\u062a \u062f\u0631 \u062c\u0646\u0648\u0628 \u06a9\u0634\u0648\u0631 \u062d\u0645\u0644\u0627\u062a \u067e\u0647\u0628\u0627\u062f\u06cc \u0627\u0646\u062c\u0627\u0645 \u062f\u0627\u062f."
  },
  {
    "id": 33,
    "text": "\u0646\u0648\u0627\u0645\u06cc\u0633 \u0686\u0631\u062e\u0634\u06cc"
  },
  {
    "id": 34,
    "text": "\u0645\u0627\u062f\u0631\u062a : \u0627\u06af\u0631 \u0645\u0646 \u0631\u0627 \u062a\u0631\u0648\u0631 \u06a9\u0631\u062f\u0646 \u0627\u0645\u06cc\u062f\u0648\u0627\u0631\u0645 \u062f\u0644\u062a\u0627\u0646 \u0628\u0631\u0627\u06cc\u0645 \u062a\u0646\u06af \u0634\u0648\u062f.\n\n\u067e\u062f\u0631\u062a : \u0627\u0632 \u0645\u0646 \u062a\u0635\u0648\u06cc\u0631 \u0634\u06cc\u0637\u0627\u0646\u06cc \u0648 \u0628\u06cc\u063a\u06cc\u0631\u062a\u06cc \u0633\u0627\u062e\u062a\u0646 \u06a9\u0647 \u0633\u0632\u0627\u0648\u0627\u0631\u0634 \u0646\u06cc\u0633\u062a\u0645.."
  },
  {
    "id": 35,
    "text": "\u0627\u0648\u0646\u0642\u062f\u0631 \u0631\u0648 \u0645\u062e \u0646\u0646\u062a \u0631\u0627\u0647 \u0645\u06cc\u0631\u0645 \u062a\u0627 \u0634\u0647\u0631\u062f\u0627\u0631\u06cc \u0622\u0633\u0641\u0627\u0644\u062a\u0634 \u06a9\u0646\u0647"
  },
  {
    "id": 36,
    "text": "\u0645\u0627\u062f\u0631\u062a \u0628\u0647 \u0641\u0631\u06cc\u062f \u06a9\u0646\u0632\u0648 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u0647\u0645\u06a9\u0627\u0631\u06cc \u06a9\u0644\u06cc\u067e \u067e\u0627\u0631\u06a9\u06cc \u062f\u0627\u062f"
  },
  {
    "id": 37,
    "text": "\u0628\u0627 \u0644\u0648\u0633\u06cc\u0644 ( \u0686\u0648\u0628 \u0628\u06cc\u0633\u0628\u0627\u0644 \u0646\u06cc\u06af\u0646 \u06a9\u0647 \u0633\u06cc\u0645 \u062e\u0627\u0631\u062f\u0627\u0631 \u06a9\u0634\u06cc\u062f\u0647 \u0634\u062f\u0647 \u0628\u0648\u062f \u062f\u0648\u0631\u0634 ) \u0632\u062f\u0645 \u062a\u0648 \u06a9\u0633\u0645\u0627\u062f\u0631\u062a"
  },
  {
    "id": 38,
    "text": "\u0645\u0627\u0645\u0627\u0646\u062a \u0632\u0646\u06af \u062f\u06a9\u062a\u0631 \u0647\u0644\u0627\u06a9\u0648\u06cc\u06cc \u0632\u062f \u0645\u0634\u0627\u0648\u0631 \u062e\u0627\u0646\u0648\u0627\u062f\u06af\u06cc \u0628\u06af\u06cc\u0631\u0647 \u062a\u0645\u0627\u0633 \u062a\u0644\u0641\u0646\u06cc \u062e\u0648\u0628 \u067e\u06cc\u0634 \u0646\u0631\u0641\u062a \u062f\u06a9\u062a\u0631 \u0647\u0644\u0627\u06a9\u0648\u06cc\u06cc \u0628\u0627 \u0645\u0627\u062f\u0631\u062a \u0633\u0627\u0639\u062a \u0647\u0627 \u0644\u0627\u0633 \u0632\u062f"
  },
  {
    "id": 39,
    "text": "\u0628\u0627 \u0627\u0633\u0627\u0644\u062a \u0631\u0627\u06cc\u0641\u0644 \u067e\u06cc\u0634\u0631\u0641\u062a\u0647 M4A1 \u0628\u0627 \u0627\u06cc\u0646 \u0644\u0648\u062f\u0627\u062a : \u062e\u0634\u0627\u0628 45 \u062a\u0627\u06cc\u06cc \u06a9\u0627\u0644\u06cc\u0628\u0631 5.56 \u00d7 45 \u0645\u06cc\u0644\u06cc\u200c\u0645\u062a\u0631 \u0646\u0627\u062a\u0648 \u060c \u0622\u0646\u062f\u0631 \u0628\u0631\u0631\u0644 \u0646\u0627\u0631\u0646\u062c\u06a9 \u0627\u0646\u062f\u0627\u0632 M203 \u060c \u0627\u0648\u067e\u062a\u06cc\u06a9 EOTech EXPS3 \u060c \u0644\u06cc\u0632\u0631 NGAL \u060c \u0627\u0633\u062a\u0627\u06a9 Magpul CTR \u0648 \u06af\u0631\u06cc\u067e Magpul RVG \u0645\u0627\u062f\u0631\u062a\u0648 \u06a9\u0634\u062a\u0645"
  },
  {
    "id": 40,
    "text": "**\u062a\u0645\u0627\u0645 \u0634\u062f\u061f \u062e\u06cc\u0644\u06cc \u062e\u0646\u062f\u0647 \u06a9\u0631\u062f\u0645 \u0645\u0627\u062f\u0631 \u062e\u06cc\u06a9 \u062e\u0648\u0644\u06cc**!\n\u0627\u06cc\u0646 \u0686\u06cc\u0647 \u062c\u0644\u0648 \u06a9\u0648\u0646 \u067e\u062f\u0631\u062a \u062d\u0644\u0642\u0647 \u06a9\u0631\u062f\u0647\u061f\n\u0627\u0648\u0646 \u0686\u06cc\u0647 \u0631\u0641\u062a\u0647 \u062a\u0648 \u06a9\u0645\u062f \u0644\u0628\u0627\u0633 \u062e\u0648\u0627\u0647\u0631\u062a\u061f\n \u06f1\u06f4\u06f0\u200c\u06f0 \u0633\u0627\u0644 \u0646\u0634\u0633\u062a\u0645 \u067e\u0627\u06cc \u062d\u0631\u0641\u062a \u0646\u0627\u0645\u0648\u0633 \u0622\u0628\u062f\u0645\u0627\u063a \u063a\u0648\u0644.\n\u0627\u06cc\u0646 \u0686\u0647 \u0631\u06cc\u062e\u062a \u0648 \u0642\u06cc\u0627\u0641\u0647\u200c\u0627\u06cc\u0647 \u0627\u062e\u0647 \u0646\u0627\u0645\u0648\u0633 \u0628\u0644\u0627\u062d\u062f\u06cc\u062f."
  },
  {
    "id": 41,
    "text": "\u0644\u0628\u0648 \u0641\u0631\u0648\u0634 \u0647\u0627 \u062a\u0627\u0628\u0633\u062a\u0627\u0646 \u0627\u0633\u062a\u0631\u0627\u062d\u062a \u062f\u0627\u0631\u0646\u062f \u0648 \u0628\u0633\u062a\u0646\u06cc \u0641\u0631\u0648\u0634 \u0647\u0627 \u0632\u0645\u0633\u062a\u0627\u0646\n\u0641\u0642\u0637 \u062c\u0646\u062f\u0647 \u0647\u0627 \u0647\u0633\u062a\u0646 \u06a9 \u062a\u0639\u0637\u06cc\u0644\u0627\u062a \u0648 \u0627\u0633\u062a\u0631\u0627\u062d\u062a \u0646\u062f\u0627\u0631\u0646 ( \u0645\u0627\u062f\u0631\u062a )"
  },
  {
    "id": 42,
    "text": "\u0645\u0627\u062f\u0631\u062a \u0645\u0634\u062a\u0631\u06cc \u062f\u06a9\u062a\u0631 \u0647\u0644\u0627\u06a9\u0648\u06cc\u06cc"
  },
  {
    "id": 43,
    "text": "\u0631\u0648 \u0641\u06cc\u0644\u0645 \u0633\u0646\u06af \u0642\u0628\u0631 \u0645\u0627\u062f\u0631\u062a \u0641\u0627\u0646\u06a9 \u062a\u06cc\u06a9\u06cc \u062a\u06cc\u06a9\u06cc \u0645\u06cc\u0646\u062f\u0627\u0632\u0645"
  },
  {
    "id": 44,
    "text": "\u06f1) \u0622\u0631\u0627\u06cc\u0647 \u0645\u062a\u0646\u0627\u0642\u0636 \u0646\u0645\u0627 \u0631\u0627 \u062f\u0631 \u062c\u0645\u0644\u0647 \u0632\u06cc\u0631 \u0628\u06cc\u0627\u0628\u06cc\u062f \u0648 \u0628\u0646\u0648\u06cc\u0633\u06cc\u062f:\n\u062e\u0648\u0627\u0647\u0631\u062a \u062f\u0631 \u0628\u06cc\u062a \u0631\u0647\u0628\u0631\u06cc \u062a\u0648\u0633\u0637 \u0645\u0648\u0634\u06a9 \u0647\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627\u06cc\u06cc \u0635\u0647\u06cc\u0648\u0646\u06cc \u0628\u0647 \u0634\u0647\u0627\u062f\u062a \u0631\u0633\u06cc\u062f \u0648 \u0628\u0647 \u062f\u0631\u06a9 \u0648\u0627\u0635\u0644 \u0634\u062f.\n\n\u06f2) \u0641\u0639\u0644 \"\u0634\u062f\" \u062c\u0645\u0644\u0647 {\u0634\u062f \u0648 \u0633\u0631 \u062f\u0631 \u0686\u0627\u0647 \u0645\u0627\u062f\u0631\u062a \u06a9\u0631\u062f } \u0627\u0633\u0646\u0627\u062f\u06cc \u0627\u0633\u062a.\n\u0627\u0644\u0641) \u062f\u0631\u0633\u062a  \u0628) \u0646\u0627\u062f\u0631\u0633\u062a \n\n\u06f3)\u0644\u06cc\u0644\u06cc \u0648 \u0645\u062c\u0646\u0648\u0646 \u0627\u0632 \u0622\u062b\u0627\u0631 \u0628\u0627\u0641\u0642\u06cc \u0645\u0634\u0647\u062f\u06cc \u0627\u0633\u062a\n\u06f1)\u062f\u0631\u0633\u062a  \u06f2)\u0646\u0627\u062f\u0631\u0633\u062a\n\n\u06f4) \u0634\u0645\u0633 \u062a\u0628\u0631\u06cc\u0632\u06cc \u0645\u0639\u0634\u0648\u0642 \u0627\u062d\u0645\u062f \u0639\u0631\u0628\u0644\u0648 \u0627\u0633\u062a\n\u06f1)\u062f\u0631\u0633\u062a  \u06f2)\u0646\u0627\u062f\u0631\u0633\u062a\n\n\u06f5) \u0639\u0628\u0627\u0631\u062a \u0632\u06cc\u0631 \u0686\u0646\u062f \u062c\u0645\u0644\u0647 \u062f\u0627\u0631\u062f\u061f\n\u067e\u062f\u0631\u062a \u062a\u0648 \u06a9\u0648\u0646 \u0627\u0633\u0628. \u0686\u0627\u0631\u0644\u06cc \u06a9\u0644\u0627\u0631\u06a9 \u062e\u0648\u0627\u0647\u0631\u062a\u0648 \u0628\u0644\u0639\u06cc\u062f. \u0639\u0646\u0645 \u062f\u0631 \u0631\u0641\u062a \u062d\u0627\u062c\u06cc \u0627\u0644\u0648. \u0645\u0627\u062f\u0631\u062a \u0632\u0627\u062e\u0627\u0631 \u0632\u062f \u0648 \u067e\u062f\u0631\u062a \u0646\u06cc\u0632."
  },
  {
    "id": 45,
    "text": "\u0628\u0647 \u0645\u0627\u062f\u0631 \u067e\u06cc\u0631 \u0627\u0644\u0632\u0627\u06cc\u0645\u0631\u06cc \u0627\u062a \u06af\u0641\u062a\u0645 \u0645\u06cc\u062f\u0648\u0646\u06cc \u062a\u0631\u0627\u0645\u067e \u06a9\u06cc\u0647\u061f \u06af\u0641\u062a \u0646\u0647 \u0646\u0645\u06cc\u062f\u0648\u0646\u0645 \n\u06af\u0641\u062a\u0645 \u06cc\u0647 \u0627\u0645\u0644\u0627\u06a9\u06cc\u0647 \u06a9\u0647 \u0645\u06cc\u062e\u0648\u0627\u062f \u0628\u06cc\u0627\u062f \u062e\u0648\u0646\u062a\u0648 \u0627\u0632 \u0686\u0646\u06af\u062a \u062f\u0631 \u0628\u06cc\u0627\u0631\u0647 \u0648\u0627\u0633\u0647 \u0647\u0645\u06cc\u0646 \u0645\u0648\u0634\u06a9 \u0645\u06cc\u0632\u0646\u0647\n\u0645\u0627\u062f\u0631\u062a \u0647\u0645 \u0627\u0632 \u0627\u06cc\u0646 \u062d\u0631\u0641\u0645 \u062a\u0631\u0633\u06cc\u062f \u0648 \u0627\u0632 \u0634\u062f\u062a \u062a\u0631\u0633\u0634 \u062a\u0648\u06cc \u067e\u0648\u0634\u06a9 \u0627\u06cc\u0632\u06cc \u0644\u0627\u06cc\u0641\u0634 \u0644\u0648\u0627\u0634\u06a9 \u0632\u0631\u062f \u0627\u0644\u0648 \u0631\u06cc\u062f"
  },
  {
    "id": 46,
    "text": "\u0633\u0648\u0633\u06a9 \u067e\u0631\u0646\u062f\u0647 \u062f\u0633\u062a \u0627\u0645\u0648\u0632\u0645 \u06a9\u0647 \u0631\u0648 \u067e\u0648\u0634\u06a9 \u0628\u0627\u0632 \u062e\u0648\u0627\u0647\u0631 \u06a9\u0648\u0686\u06cc\u06a9\u062a \u06a9\u0647 \u0627\u0646\u062f\u0627\u0632\u0647 \u06a9\u06cc\u0631\u062e\u0631 \u0631\u06cc\u062f\u0647 \u0641\u0631\u0648\u062f \u0645\u06cc\u0627\u062f \u0634\u0631\u0645\u0634 \u0645\u06cc\u0634\u0647 \u06a9\u0647 \u0631\u0648 \u06a9\u0648\u0646 \u0646\u0646\u062a \u0641\u0631\u0648\u062f \u0628\u06cc\u0627\u062f"
  },
  {
    "id": 47,
    "text": "\u0633\u0627\u06cc\u0632 \u0645\u0645\u0647 \u0647\u0627\u06cc \u0645\u0627\u062f\u0631\u062a \u0627\u0632 \u0633\u0627\u06cc\u0632 \u0645\u0645\u0647 \u0647\u0627\u06cc \u06a9\u0627\u0631\u0627\u06a9\u062a\u0631 \u0647\u0627\u06cc rule34 \u0647\u0645 \u06af\u0646\u062f\u0647 \u062a\u0631\u0647"
  },
  {
    "id": 48,
    "text": "\u0633\u0648\u0644\u0627\u062e\u0627\u06cc \u0645\u0627\u062f\u0631\u062a\u0648 \u06a9\u0627\u0646\u0641\u06cc\u06af \u06a9\u0631\u062f\u0645 \u0648\u0644\u06cc \u0641\u0627\u06cc\u0631\u0648\u0627\u0644 \u0631\u0648\u0634 \u0646\u0635\u0628 \u0646\u06a9\u0631\u062f\u0645 \u0628\u0647 \u0645\u0627\u062f\u0631\u062a \u0647\u0645 \u062a\u0630\u06a9\u0631 \u062f\u0627\u062f\u0645 \u0633\u0648\u0644\u0627\u062e \u0647\u0627\u0634\u0648 \u0628\u0647 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a \u0648\u0635\u0644 \u0646\u06a9\u0646\u0647 \u0646\u0646\u0647 \u06a9\u0648\u062f\u0646\u062a \u0627\u0648\u0645\u062f \u0648\u0635\u0644 \u06a9\u0631\u062f \u0647\u0645\u0647 \u0633\u0648\u0644\u0627\u062e\u0627\u0634 zero day \u062e\u0648\u0631\u062f (\u0647\u0631\u0686\u06cc \u06a9\u06cc\u0631\u0647 \u0631\u0641\u062a \u062a\u0648 \u0633\u0648\u0644\u0627\u062e\u0627\u06cc \u0645\u0627\u062f\u0631\u062a)"
  },
  {
    "id": 49,
    "text": "\u0627\u062e\u0631\u06cc\u0646 \u0633\u0627\u06cc\u0632 \u0633\u06cc\u0646\u0647 KK \u0647\u0633\u062a \u0648\u0644\u06cc \u0648\u0642\u062a\u06cc \u0645\u062f\u06cc\u0631\u0627\u0646 \u0627\u0646\u062c\u0645\u0646 \u062a\u062e\u0645\u06cc\u0646 \u0633\u0627\u06cc\u0632 \u0633\u06cc\u0646\u0647 \u062f\u0646\u06cc\u0627 \u0645\u0645\u0647 \u0647\u0627\u06cc \u0645\u0627\u062f\u0631\u062a\u0648 \u062f\u06cc\u062f\u0646 \u06cc\u0647 \u0633\u0627\u06cc\u0632 \u062c\u062f\u06cc\u062f \u0628\u0646\u0627\u0645 \u0627\u0698\u062f\u0631 \u0632\u0627\u062f\u0647(\u0627\u0633\u0645 \u06a9\u06cc\u0631 \u0645\u0646) \u0633\u0627\u062e\u062a\u0646 \u0648 \u0633\u0627\u06cc\u0632 \u0645\u0645\u0647 \u0647\u0627\u06cc \u0645\u0627\u062f\u0631\u062a\u0648 \u0628\u0627 \u0627\u0648\u0646 \u062a\u062e\u0645\u06cc\u0646 \u0632\u062f\u0646 (\u06a9\u06cc\u0631\u0645 \u0627\u0646\u062f\u0627\u0632\u0647 \u0645\u0645\u0647 \u0647\u0627\u06cc \u0645\u0627\u062f\u0631\u062a\u0647) \n\u0645\u06cc\u062a\u0648\u0646\u0645 \u0628\u06af\u0645 \u06cc\u062c\u0648\u0631\u0627\u06cc\u06cc \u06a9\u06cc\u0631\u0645 \u0648\u0627\u0642\u0639\u0627 \u0628\u0631\u0627\u06cc \u0645\u0645\u0647 \u0647\u0627\u06cc \u0645\u0627\u062f\u0631\u062a \u0633\u0627\u062e\u062a\u0647 \u0634\u062f\u0647"
  },
  {
    "id": 50,
    "text": "\u0645\u0627\u062f\u0631\u062a \u0627\u0632 \u0627\u0646\u0627\u0644 \u0628\u06cc\u062f\u0632 \u0628\u062c\u0627\u06cc \u062a\u0633\u0628\u06cc\u062d \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u06a9\u0646\u0647"
  },
  {
    "id": 51,
    "text": "\u0631\u0627\u0645\u06cc\u0646 \u0631\u0636\u0627\u06cc\u06cc\u0627\u0646 \u0641\u0645\u0628\u0648\u06cc \u0648 \u0628\u0631\u062f\u0647 \u0645\u0627\u062f\u0631\u062a\u0647 \u0648\u0642\u062a\u06cc \u0645\u0627\u062f\u0631\u062a \u062e\u0633\u062a\u0633 \u0631\u0648\u06cc \u06a9\u0645\u0631 \u0631\u0627\u0645\u06cc\u0646 \u0631\u0636\u0627\u06cc\u06cc\u0627\u0646 \u0645\u06cc\u0634\u06cc\u0646\u0647 \u0648 \u0628\u0639\u0636\u06cc \u0648\u0642\u062a\u0627 \u0628\u0627 \u06a9\u0641\u0634 \u067e\u0627\u0634\u0646\u0647 \u0628\u0644\u0646\u062f\u0634 \u06a9\u06cc\u0631 \u0631\u0627\u0645\u06cc\u0646 \u0631\u0648 \u0644\u06af\u062f \u0645\u06cc\u06a9\u0646\u0647"
  },
  {
    "id": 52,
    "text": "\u0686\u0646\u0627\u0646 \u0628\u0631 \u0642\u0628\u0631 \u0645\u0627\u062f\u0631\u062a \u0628\u06af\u0648\u0632\u0645 \u06a9\u0647 \u0632\u0644\u0632\u0644\u0647 \u0628\u06cc\u0627\u062f"
  },
  {
    "id": 53,
    "text": "\u0633\u06cc\u0645\u06a9\u0627\u0631\u062a \u0645\u0627\u062f\u0631\u062a\u0648 \u0633\u0648\u0632\u0648\u0646\u062f\u0645 \u062a\u0627 \u0646\u062a\u0648\u0646\u0647 \u0628\u0627 \u067e\u062f\u0631\u062a \u06a9\u0647 \u0631\u0641\u062a\u0647 \u0645\u0627\u0645\u0648\u0631\u06cc\u062a \u0632\u0646\u06af \u0628\u0632\u0646\u0647 \u062a\u0627 \u0628\u062a\u0648\u0646\u0645 \u0628\u06cc\u0634\u062a\u0631 \u0645\u0627\u062f\u0631\u062a\u0648 \u0628\u06af\u0627\u0645"
  },
  {
    "id": 54,
    "text": "\u0645\u0646\u0648 \u067e\u062f\u0631\u062a \u0645\u0633\u0627\u0628\u0642\u0647 \u062f\u06cc\u0631 \u0627\u0646\u0632\u0627\u0644\u06cc \u06af\u0630\u0627\u0634\u062a\u06cc\u0645\n\u0646\u0645\u06cc\u062f\u0648\u0646\u0645 \u0686\u0631\u0627 \u0627\u06cc\u0646 \u0648\u0633\u0637 \u0645\u0627\u062f\u0631\u062f \u0628\u0627\u062e\u062a"
  },
  {
    "id": 55,
    "text": "\u0633\u067e\u0627\u0647 \u0645\u0648\u0634\u06a9 \u0634\u0644\u06cc\u06a9 \u0645\u06cc\u06a9\u0646\u0647 \u0628\u0647 \u067e\u0627\u06cc\u06af\u0627\u0647 \u0647\u0627\u06cc \u0627\u0645\u0631\u06cc\u06a9\u0627\n\u0645\u0646\u0645 \u06a9\u06cc\u0631 \u0634\u0644\u06cc\u06a9 \u0645\u06cc\u06a9\u0646\u0645 \u0628\u0647 \u0633\u0648\u0644\u0627\u062e \u0647\u0627\u06cc \u0645\u0627\u062f\u0631\u062a"
  },
  {
    "id": 56,
    "text": "\u0627\u06cc\u0646\u0642\u062f\u0631 \u0627\u062f\u0645 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u0627\u06cc \u0647\u0633\u062a\u0645 \u06a9\u0647 \u0645\u06cc\u062f\u0648\u0646\u0645 \u0645\u0627\u062f\u0631\u062a \u062a\u0648 \u0633\u0627\u0644 \u06f2\u06f0\u06f1\u06f5 \u0628\u0627 \u0622\u06cc\u0641\u0648\u0646 \u06f5 \u06a9\u0627\u0631 \u062c\u0646\u062f\u06af\u06cc\u0634\u0648 \u0634\u0631\u0648\u0639 \u06a9\u0631\u062f"
  },
  {
    "id": 57,
    "text": "\u0645\u0648\u0647\u0627\u06cc \u0645\u0627\u062f\u0631\u062a\u0648 \u06a9\u0646\u062f\u0645 \u06a9\u0631\u062f\u0645 \u062a\u0648 \u06a9\u0648\u0646\u0645 \u062a\u0628\u062f\u06cc\u0644 \u0634\u062f\u0645 \u0628\u0647 \u067e\u0648\u0646\u06cc \u06a9\u0648\u0686\u0648\u0644\u0648"
  },
  {
    "id": 58,
    "text": "\u067e\u062f\u0631\u062a \u063a\u06cc\u0631\u062a\u0634\u0648 \u0627\u0632 \u0627\u0645\u0627\u0645 \u0639\u0644\u06cc \u0627\u0633\u06a9\u06cc \u0631\u0641\u062a\u0647"
  },
  {
    "id": 59,
    "text": "\u062c\u0627\u06cc \u062a\u0633\u0645\u0647 \u062a\u0627\u06cc\u0645 \u0645\u0627\u0634\u06cc\u0646 \u0628\u0627\u0628\u0627\u062a \u0631\u0648 \u0628\u0627 \u0634\u0648\u0631\u062a \u0645\u0627\u062f\u0631\u062a \u0639\u0648\u0636 \u06a9\u0631\u062f\u0645 \u062a\u0627 \u0645\u0648\u0642\u0639 \u0627\u0633\u062a\u0627\u0631\u062a \u0632\u062f\u0646 \u0645\u0627\u0634\u06cc\u0646 \u0635\u062f\u0627 \u063a\u06cc\u0631\u062a \u0627\u0642\u0627\u062a \u0631\u0648 \u06cc\u06a9 \u0634\u0647\u0631 \u0628\u0634\u0646\u0648\u0646"
  },
  {
    "id": 60,
    "text": "\u0645\u0627\u062f\u0631\u062a \u0627\u06cc\u0646 \u0634\u0639\u0631\u0648 \u0628\u0631\u0627\u0645 \u062e\u0648\u0646\u062f:\n\u0645\u0646 \u0647\u0645\u0648\u0646\u0645 \u06a9\u0647 \u0632\u06cc\u0631\u062a \u0645\u06cc\u0645\u06cc\u0631\u0645\n\u0628\u06cc \u06a9\u06cc\u0631\u062a \u0645\u06cc\u0645\u06cc\u0631\u0645\n\u06a9\u06cc\u0631\u062a\u0648 \u06a9\u0647 \u0645\u06cc\u06af\u06cc\u0631\u0645\n\u0631\u0648\u0628\u0647 \u0631\u0627\u0647\u0647 \u062d\u0627\u0644\u0645\n\u0631\u0648\u06cc \u06a9\u06cc\u0631\u062a \u0645\u06cc\u0634\u06cc\u0646\u0645\n\u0628\u0647\u062a \u0642\u0648\u0644 \u0645\u06cc\u062f\u0645\n\u0631\u0648\u06cc \u06a9\u06cc\u0631\u062a \u0645\u06cc\u0645\u06cc\u0631\u0645"
  },
  {
    "id": 61,
    "text": "\u0645\u0627\u062f\u0631\u062a \u0645\u0647\u0631\u0647 \u0627\u062e\u0631 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc"
  },
  {
    "id": 62,
    "text": "\u0628\u0627 \u063a\u06cc\u0631\u062a \u062a\u0631\u06cc\u0646 \u0641\u0631\u062f \u0628\u06cc\u0646 \u0645\u06a9\u0627\u0644\u0645\u0627\u062a \u06a9\u0646\u0641\u0631\u0627\u0646\u0633\u06cc \u062a\u0648 \u0648 \u0628\u0627\u0628\u0627 \u0648 \u062f\u0627\u06cc\u06cc\u062a \u06a9\u0627\u0631\u0645\u0646\u062f \u0645\u062e\u0627\u0628\u0631\u0627\u062a\u0647"
  },
  {
    "id": 63,
    "text": "\u0627\u06af\u0647 \u0627\u0632 Ai \u0628\u062e\u0648\u0627\u0646 \u06cc\u0647 \u0627\u0646\u06cc\u0645\u06cc\u0634\u0646 \u0644\u06af\u0648\u06cc\u06cc \u0627\u0632 \u0631\u0648\u0627\u0628\u0637 \u0645\u0627\u062f\u0631\u062a \u0628\u0633\u0627\u0632\u0647 \u0642\u0627\u0637\u0639\u0627\u0646\u0647 \u067e\u0627\u0633\u062e \u0645\u06cc\u062f\u0647 \" \u0645\u0646 \u0646\u0645\u06cc\u062a\u0648\u0627\u0646\u0645 \u0627\u06cc\u0646 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0631\u0627 \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u0645 \" \u0634\u0627\u06cc\u062f \u0641\u06a9\u0631 \u06a9\u0646\u06cc \u062f\u0644\u0627\u06cc\u0644 \u0627\u0645\u0646\u06cc\u062a\u06cc \u062f\u0627\u0631\u0647 \u0648\u0644\u06cc AI \u0627\u0632 \u0627\u0646\u062c\u0627\u0645 \u06a9\u0627\u0631\u0647\u0627\u06cc \u0628\u06cc\u0646\u0647\u0627\u06cc\u062a \u0645\u062a\u0646\u0641\u0631\u0647 !!"
  },
  {
    "id": 64,
    "text": "\u0686\u06cc\u0686\u06cc \u0645\u06cc\u06af\u0648\u06cc \u06a9\u0648\u0635\u062f\u0647 \u0645\u0627\u062f\u0631"
  },
  {
    "id": 65,
    "text": "\u06a9\u0648\u0633 \u0646\u0646\u062a"
  },
  {
    "id": 66,
    "text": "\u0646\u0648\u0627\u0645\u06cc\u0633 \u0648\u0627\u0644\u06cc\u0628\u0627\u0644\u06cc\u0633\u062a"
  },
  {
    "id": 67,
    "text": "\u062f\u0627\u0644\u06af \u06a9\u0644\u0627\u063a\u067e\u0631"
  },
  {
    "id": 68,
    "text": "\u06a9\u0648\u0633 \u0627\u0648\u0646 \u0645\u0627\u062f\u0631\u062a"
  },
  {
    "id": 69,
    "text": "\u0686\u0648\u0633 \u0644\u0648\u0626\u06cc \u0634\u0648\u0646\u0632\u062f\u0647\u0645 \u0632\u062f\u0645 \u062f\u0647\u0646 \u0645\u0627\u062f\u0631\u062a \u062d\u06a9\u0648\u0645\u062a\u0634 \u06a9\u0645 \u062f\u0648\u0627\u0645 \u062a\u0631\u06cc\u0646 \u062d\u06a9\u0648\u0645\u062a \u062a\u0627\u0631\u06cc\u062e \u0634\u062f"
  },
  {
    "id": 70,
    "text": "\u0686\u0648\u0633 \u06a9\u0627\u0628\u0648\u06cc \u0632\u062f\u0645 \u062a\u0648 \u0635\u0648\u0631\u062a \u0645\u0627\u062f\u0631\u062a \u06cc\u0647 \u0634\u0628\u0647 \u0634\u062f \u0637\u0631\u0648\u0641\u062f\u0627\u0631 \u067e\u0631\u0648 \u067e\u0627 \u0642\u0631\u0635 \u06a9\u0644\u06cc\u0646\u062a \u0627\u06cc\u0633\u062a\u0648\u0648\u062f"
  },
  {
    "id": 71,
    "text": "\u0686\u0627\u0631\u0635\u062f\u0648 \u067e\u0646\u062c \u067e\u0698\u0648 \u067e\u0627\u0631\u0633\n\u062a\u06cc\u0645 \u0646\u0646\u062a \u0627\u0632 \u0646\u0627\u0645\u0631\u062f\u0627\u0633"
  },
  {
    "id": 72,
    "text": "\u067e\u06cc\u0634 \u0645\u0631\u06af \u0645\u0627\u062f\u0631\u062a\u0645\n\u06a9\u0646\u06cc\u0632 \u0645\u0627\u062f\u0631\u062a\u0645\n\u0646\u0648\u06a9\u0631 \u0645\u0627\u062f\u0631\u062a\u0645\n\u0633\u06af \u0645\u0627\u062f\u0631\u062a\u0645\n\u0633\u06cc\u0646\u0647 \u0632\u0646 \u0645\u0627\u062f\u0631\u062a\u0645\n\u0641\u062f\u0627\u06cc\u06cc \u0645\u0627\u062f\u0631\u062a\u0645\n\u0642\u0631\u0628\u0627\u0646\u06cc \u0645\u0627\u062f\u0631\u062a\u0645\n\u062f\u0648\u0631\u06af\u0631\u062f \u0645\u0627\u062f\u0631\u062a\u0645\n\u06af\u062f\u0627\u06cc \u0645\u0627\u062f\u0631\u062a\u0645\n\u0628\u0627\u0632\u06cc\u0686\u0647 \u0645\u0627\u062f\u0631\u062a\u0645\n\u067e\u0631\u0633\u062a\u0627\u0631 \u0645\u0627\u062f\u0631\u062a\u0645\n\u0636\u0627\u0645\u0646 \u0645\u0627\u062f\u0631\u062a\u0645\n\u0634\u0627\u0647\u062f \u0645\u0627\u062f\u0631\u062a\u0645\n\u0645\u0648\u06a9\u0644 \u0645\u0627\u062f\u0631\u062a\u0645\n\u062d\u0645\u0627\u0644 \u0645\u0627\u062f\u0631\u062a\u0645\n\u0628\u0627\u0631\u0628\u0631 \u0645\u0627\u062f\u0631\u062a\u0645\n\u0631\u0627\u0646\u0646\u062f\u0647 \u0645\u0627\u062f\u0631\u062a\u0645\n\u0646\u0638\u0627\u0641\u062a\u0686\u06cc \u0645\u0627\u062f\u0631\u062a\u0645\n\u062e\u062f\u0645\u062a\u06a9\u0627\u0631 \u0645\u0627\u062f\u0631\u062a\u0645\n\u062a\u0639\u0645\u06cc\u06a9\u0627\u0631 \u0645\u0627\u062f\u0631\u062a\u0645\n\u0642\u0631\u0645\u0633\u0627\u0642 \u0645\u0627\u062f\u0631\u062a\u0645\n\u067e\u0641\u06cc\u0648\u0632 \u0645\u0627\u062f\u0631\u062a\u0645\n\u0639\u0646 \u0645\u0627\u062f\u0631\u062a\u0645\n\u0634\u0627\u0634 \u0645\u0627\u062f\u0631\u062a\u0645\n\u0622\u0631\u0648\u0642 \u0645\u0627\u062f\u0631\u062a\u0645"
  },
  {
    "id": 73,
    "text": "\u063a\u06cc\u0631\u062a \u067e\u062f\u0631\u062a \u0645\u062b\u0644 \u0645\u062c\u062a\u0628\u06cc \u062e\u0627\u0645\u0646\u0647 \u0627\u06cc\u0647\u060c \u0632\u062f\u0646 \u0632\u0646\u0648 \u0628\u0686\u0634\u0648 \u062e\u0627\u0646\u0648\u0627\u062f\u0634\u0648 \u06af\u0627\u06cc\u06cc\u062f\u0646 \u0645\u06cc\u200c\u0631\u0647 \u0628\u0627 \u0628\u06a9\u0646\u0627\u0634 \u062a\u0648\u0627\u0641\u0642 \u0645\u06cc\u200c\u06a9\u0646\u0647 \u06a9\u0647 \u062e\u0648\u0627\u0647\u0631\u0634\u0648 \u062f\u06cc\u06af\u0647 \u0646\u06af\u0627\u0646"
  },
  {
    "id": 74,
    "text": "\u0645\u0627\u062f\u0631\u062a \u0627\u0633\u062a\u0648\u0631\u06cc \u06a9\u0631\u062f\u0647:\n\u0641\u0631\u0632\u0646\u062f \u0627\u06cc\u0631\u0627\u0646 \u0648 \u062c\u0627\u0646 \u0641\u062f\u0627\u06cc \u0645\u06cc\u0647\u0646\u061b \n\u0633\u06cc\u062f \u0639\u0644\u06cc \u062d\u0633\u06cc\u0646\u06cc \u062e\u0627\u0645\u0646\u0647\u200c\u0627\u06cc\u060c \n\u06f9 \u0627\u0633\u0641\u0646\u062f\u060c \n\u062a\u0647\u0631\u0627\u0646 \u0639\u0632\u06cc\u0632 :)"
  },
  {
    "id": 75,
    "text": "\u06a9\u06cc\u0631\u0645\u0648 \u0645\u062b\u0644 \u0633\u0646\u06af\u0631\u0634\u06a9\u0646 b-2 \u0631\u0648 \u062e\u0648\u0646\u0647 \u0645\u0627\u062f\u0631\u062a \u0641\u0631\u0648\u062f \u0645\u06cc\u0627\u0631\u0645"
  },
  {
    "id": 76,
    "text": "\u0645\u0627\u062f\u0631\u062a \u062c\u0646\u062f\u0633\u061f\n\u062c\u0627\u06a9\u0634\u0647\u061f\n\u06a9\u0648\u0646\u06cc\u0647\u061f\n\u0639\u0631\u0642 \u062e\u0648\u0631\u0647\u061f\n\u062f\u0632\u062f\u0647\u061f\n\u0627\u06cc\u0646 \u0686\u0646\u062f \u0631\u0648\u0632 \u0645\u06cc\u062e\u0648\u0627\u062f \u062d\u0633\u06cc\u0646\u06cc \u0628\u0627\u0634\u0647!"
  },
  {
    "id": 77,
    "text": "\u062e\u0645\u06cc\u0646\u06cc : \u0633\u06a9\u0633 \u0644\u0627\u067e\u0627\u06cc\u06cc \u0628\u0627 \u0645\u0627\u062f\u0631\u062a \u0645\u0627\u0646\u0639\u06cc \u0646\u062f\u0627\u0631\u062f"
  },
  {
    "id": 78,
    "text": "\u0686\u0648\u0633 \u0646\u0626\u0627\u0646\u062f\u0631\u062a\u0627\u0644 \u0632\u062f\u0645 \u0631\u0648 \u0635\u0648\u0631\u062a \u0645\u0627\u062f\u0631\u062a \u063a\u0627\u0631\u0646\u0634\u06cc\u0646 \u0634\u062f"
  },
  {
    "id": 79,
    "text": "\u0634\u0631\u062a \u0634\u0644\u0648\u0627\u0631 \u0646\u0627\u0645\u0648\u0633\u062a\u0648 \u062f\u0632\u062f\u06cc\u062f\u0645 \u0645\u062c\u0628\u0648\u0631 \u0634\u062f \u06a9\u0644 \u062e\u06cc\u0627\u0628\u0648\u0646\u0648 \u06a9\u0648\u0646 \u0644\u062e\u062a \u0628\u06cc\u0648\u0641\u062a\u0647 \u062f\u0646\u0628\u0627\u0644\u0645"
  }
]