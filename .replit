# SelfTG - Replit run configuration
#
# Dependency manager: pip. This file intentionally ships no poetry.lock and no
# [tool.poetry] section, which is what makes Replit read requirements.txt
# instead of trying to resolve a Poetry project. Do not re-add poetry.lock.
language = "python3"
entrypoint = "main.py"

hidden = ["venv", ".config", "**/__pycache__", "**/.mypy_cache", "**/*.pyc"]

# Replit retired the python-3.8/python-3.9 module IDs and silently maps them to
# 3.10, so declare 3.10 explicitly instead of relying on the upgrade map.
modules = ["python-3.10"]

[nix]
# stable-21_11 no longer exists in Replit's module set.
channel = "stable-23_05"
packages = ["openssl"]

[env]
# Without this, Replit's log pane shows nothing until the buffer fills.
PYTHONUNBUFFERED = "1"

[unitTest]
language = "python3"

[agent]
expertMode = true

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
mode = "parallel"
author = 14474854

[[workflows.workflow.tasks]]
task = "shell.exec"
# The old command pointed at .pythonlibs/bin/python, which only exists in
# Poetry mode. With pip, the Repl interpreter already has the packages.
args = "python3 main.py"

# dashboard.py is a separate Flask app that main.py never starts. Leaving the
# port mapped made Replit wait for a listener that never opens, so it is
# commented out until the dashboard is actually wired into the run command.
# [[ports]]
# localPort = 5000
# externalPort = 80
